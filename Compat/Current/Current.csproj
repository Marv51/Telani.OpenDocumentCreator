<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>OdcCompat.Current</AssemblyName>
    <RootNamespace>OdcCompat</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsPublishable>false</IsPublishable>
    <NoWarn>$(NoWarn);CA1861</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Only the working copy. The released library is built by the sibling project. -->
    <ProjectReference Include="..\..\src\Telani.OpenDocumentCreator.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\Recipe.cs" Link="Recipe.cs" />
    <Compile Include="..\Shared\Build.cs" Link="Build.cs" />
  </ItemGroup>

</Project>
